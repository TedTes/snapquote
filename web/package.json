{
  "name": "@snapquote/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "dev": "vite --host 0.0.0.0",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "deploy": "pnpm build && wrangler pages deploy dist --project-name snapquote-public"
  },
  "dependencies": {
    "@snapquote/shared": "workspace:*",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.17",
    "@types/react-dom": "^19.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4",
    "wrangler": "^4.30.0"
  }
}
