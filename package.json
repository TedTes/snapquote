{
  "name": "snapquote",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.13.0 <25",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:api": "pnpm --filter @snapquote/shared build && pnpm --filter @snapquote/prompts build && pnpm --filter @snapquote/api dev",
    "dev:mobile": "pnpm --filter @snapquote/mobile dev",
    "dev:mobile:clear": "pnpm --filter @snapquote/mobile exec expo start --clear",
    "dev:worker": "pnpm --filter @snapquote/shared build && pnpm --filter @snapquote/worker dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^22.13.0",
    "eslint": "^9.31.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0",
    "vitest": "^3.2.4"
  }
}
