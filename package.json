{
  "name": "snapquote",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.13.0 <25",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:mobile": "pnpm --filter @snapquote/mobile dev",
    "dev:mobile:clear": "pnpm --filter @snapquote/mobile exec expo start --clear",
    "dev:web": "pnpm --filter @snapquote/web dev",
    "eas-build-post-install": "pnpm --filter @snapquote/shared build",
    "build:web": "pnpm --filter @snapquote/web build",
    "supabase:db:push": "cd infra/supabase && supabase db push",
    "supabase:functions:serve": "cd infra/supabase && supabase functions serve snapquote --env-file ../../.env",
    "supabase:functions:deploy": "cd infra/supabase && supabase functions deploy snapquote --use-api --no-verify-jwt",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^22.13.0",
    "eslint": "^9.31.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0",
    "vitest": "^3.2.4"
  }
}
